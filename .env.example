APP_NAME=Status
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Singapore
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=status
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# File drivers keep the shared Postgres database free of framework tables.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# AES-256-GCM field encryption + HMAC blind indexes.
# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
# Must match the key used by the legacy Deno app to read existing rows.
ENCRYPTION_KEY=

# Password hashing: argon2id (default) or bcrypt
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

# Leave a channel empty to disable it.
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

VITE_APP_NAME="${APP_NAME}"
