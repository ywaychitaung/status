    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:2fl+KtvkdphvQyEfm8KceW4xgB2a8xYl3hYp4mR0zq8="/>
